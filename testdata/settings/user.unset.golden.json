{
  "effortLevel": "high",
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": 8192,
    "FOO": "bar"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "gofmt -l .",
            "type": "command"
          }
        ],
        "matcher": "Edit"
      }
    ]
  },
  "model": "fable",
  "permissions": {
    "allow": [
      "Bash(go test:*)"
    ],
    "deny": []
  },
  "someFutureKey": {
    "nested": [
      1,
      2.5,
      null,
      "x"
    ]
  },
  "theme": "dark"
}
