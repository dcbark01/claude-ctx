{
  "_claudeCtx": {
    "context": "opus-b",
    "managedKeys": [
      "apiKeyHelper",
      "env.ANTHROPIC_BASE_URL",
      "env.ANTHROPIC_CUSTOM_MODEL_OPTION",
      "env.ANTHROPIC_CUSTOM_MODEL_OPTION_NAME",
      "env.ANTHROPIC_DEFAULT_HAIKU_MODEL",
      "env.ANTHROPIC_DEFAULT_OPUS_MODEL",
      "env.ANTHROPIC_DEFAULT_SONNET_MODEL",
      "env.ANTHROPIC_MODEL",
      "env.CLAUDE_CODE_API_KEY_HELPER_TTL_MS",
      "env.CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY"
    ],
    "version": 1,
    "hash": "HASH"
  },
  "apiKeyHelper": "claude-ctx credential",
  "effortLevel": "high",
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "env": {
    "ANTHROPIC_BASE_URL": "https://litellm-b.myorg.internal",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "anthropic/claude-opus-5",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Opus 5 (deployment B)",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "anthropic/claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "anthropic/claude-opus-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "anthropic/claude-sonnet-5",
    "ANTHROPIC_MODEL": "anthropic/claude-opus-5",
    "CLAUDE_CODE_API_KEY_HELPER_TTL_MS": "3600000",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": 8192,
    "FOO": "bar"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "gofmt -l .",
            "type": "command"
          }
        ],
        "matcher": "Edit"
      }
    ]
  },
  "model": "fable",
  "permissions": {
    "allow": [
      "Bash(go test:*)"
    ],
    "deny": []
  },
  "someFutureKey": {
    "nested": [
      1,
      2.5,
      null,
      "x"
    ]
  },
  "theme": "dark"
}
